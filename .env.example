# Environment variables for the Student MLOps project
# Copy this file to .env and fill in your values
# .env is in .gitignore — never commit real secrets!

# MLflow tracking server URI (local by default)
MLFLOW_TRACKING_URI=mlruns

# Model name registered in MLflow Model Registry
REGISTERED_MODEL_NAME=student_performance_model

# API settings
API_HOST=0.0.0.0
API_PORT=8000

# Retraining trigger threshold (retrain if accuracy drops below this)
ACCURACY_THRESHOLD=0.75
DRIFT_THRESHOLD=0.1
